{
  "name": "activity-ranking-api-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spec-first BDD suite for the Activity Ranking API (city-based 7-day weather activity rankings).",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "bddgen && playwright test --project=spec",
    "test:smoke": "bddgen && playwright test --project=spec --grep @smoke",
    "test:contract": "bddgen && playwright test --project=spec --grep @contract",
    "test:scoring": "bddgen && playwright test --project=spec --grep @scoring",
    "test:resilience": "bddgen && playwright test --project=spec --grep @resilience",
    "test:live": "bddgen && playwright test --project=live",
    "test:report": "playwright show-report reports/playwright",
    "validate": "bddgen",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "stub-upstream": "tsx scripts/stub-upstream.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.5",
    "playwright-bdd": "^9.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  }
}
