# Where the (not yet written) Activity Ranking API is listening.
API_BASE_URL=http://localhost:3000

# Port the in-process Open-Meteo test double binds to.
# The system under test must be started with its Open-Meteo base URLs pointed here:
#   OPEN_METEO_GEOCODING_BASE_URL=http://localhost:8787/geocoding
#   OPEN_METEO_FORECAST_BASE_URL=http://localhost:8787/forecast
FAKE_OPEN_METEO_PORT=8787

# Per-request timeout the suite applies when calling the API under test (ms).
API_TIMEOUT_MS=5000
